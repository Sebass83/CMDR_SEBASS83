---
/**
 * Landing — CMDR SEBASS83 commander log home.
 * Brand hero, "about the commander" placeholder block and latest blog entries.
 * The blog grid derives from the content collection: non-draft entries,
 * sorted by pubDate DESC.
 */
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout>
  <section class="brand-hero">
    <div class="container brand-hero-inner">
      <p class="brand-kicker">BITÁCORA DE NAVEGACIÓN // SECTOR 001</p>

      <h1 class="brand-title">CMDR SEBASS83</h1>

      <p class="brand-typewrap">
        <span class="brand-type" id="typewriter-line" data-text="Bitácora de navegación: expediciones, señales e investigación independiente."></span><span class="brand-caret" id="typewriter-caret">▍</span>
      </p>

      <div class="brand-badges">
        <span class="badge badge-amber"><span class="dot"></span>Estado: EN CURSO</span>
        <span class="badge badge-cyan">Sector: POR ASIGNAR</span>
        <span class="badge badge-slate">Rango: PILOTO INDEPENDIENTE</span>
      </div>

      <div class="brand-cta">
        <a class="btn" href="#sobre">Sobre el commander</a>
        <a class="btn btn-cyan" href="#entradas">Últimas entradas</a>
      </div>
    </div>

    <!-- Decorative HUD sensor, echoing the RAXXLA hero -->
    <div class="brand-radar" aria-hidden="true">
      <div class="radar">
        <span class="blip" style="top: 30%; left: 62%"></span>
        <span class="blip" style="top: 64%; left: 30%; animation-delay: 0.8s"></span>
        <span class="blip" style="top: 48%; left: 48%; animation-delay: 1.6s"></span>
      </div>
      <p>SENSOR // SECTOR 001&nbsp;&nbsp;—&nbsp;&nbsp;SEÑAL ACTIVA</p>
    </div>
  </section>

  <section id="sobre">
    <div class="container">
      <header class="sec-head reveal">
        <span class="sec-code">SECCIÓN 00 // IDENTIDAD</span>
        <h2>Sobre el commander</h2>
        <p class="sec-sub">Registro de identidad del comandante: foto carnet y datos de archivo de vuelo.</p>
      </header>

      <div class="id-card panel reveal">
        <header class="id-head">
          <span class="id-kicker">REGISTRO DE PILOTO // IDENTIFICACIÓN</span>
          <span class="badge badge-amber"><span class="dot"></span>IDENTIFICACIÓN ACTIVA</span>
        </header>

        <div class="id-grid">
          <figure class="id-photo">
            <img
              src={import.meta.env.BASE_URL + 'cmdr_sebass83.png'}
              alt="Fotografía de identificación de CMDR SEBASS83"
              width="896"
              height="1195"
              loading="lazy"
            />
            <figcaption>FOTO // CARNET</figcaption>
            <span class="id-scanline" aria-hidden="true"></span>
          </figure>

          <dl class="id-fields">
            <div class="id-field">
              <dt>NOMBRE</dt>
              <dd>CMDR SEBASS83</dd>
            </div>
            <div class="id-field">
              <dt>RAZA</dt>
              <dd>HUMANO</dd>
            </div>
            <div class="id-field">
              <dt>GÉNERO</dt>
              <dd>MASCULINO</dd>
            </div>
            <div class="id-field">
              <dt>NACIMIENTO</dt>
              <dd>3269</dd>
            </div>
            <div class="id-field">
              <dt>ALIANZA</dt>
              <dd>DARK WHEEL · FEDERACIÓN · OTROS</dd>
            </div>
            <div class="id-field">
              <dt>HORAS DE VUELO</dt>
              <dd>~810 HS</dd>
            </div>
          </dl>
        </div>

        <footer class="id-foot">
          <span>— CMDR SEBASS83 // REGISTRO DE VUELO</span>
          <span>ARCHIVO ABIERTO // 3312</span>
        </footer>
      </div>
    </div>
  </section>

  <section id="entradas">
    <div class="container">
      <header class="sec-head reveal">
        <span class="sec-code">REGISTRO // ENTRADAS RECIENTES</span>
        <h2>Últimas entradas</h2>
        <p class="sec-sub">Puntos de la bitácora, de la más reciente a la más antigua.</p>
      </header>

      {
        posts.length > 0 ? (
          <div class="entries-grid">
            {posts.map((post, i) => <PostCard post={post} index={i + 1} />)}
          </div>
        ) : (
          <div class="panel entries-empty reveal">
            <span class="panel-tag">BITÁCORA VACÍA</span>
            <p>Sin entradas publicadas todavía. La primera entrada estará disponible pronto.</p>
          </div>
        )
      }
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .brand-hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-5);
    text-align: center;
    overflow: hidden;
  }

  .brand-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .brand-kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--cyan-dim);
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 11vw, 7rem);
    line-height: 0.98;
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    color: var(--amber-soft);
    text-shadow:
      0 0 40px rgba(255, 158, 0, 0.45),
      0 0 90px rgba(255, 158, 0, 0.2),
      2px 0 0 rgba(102, 204, 255, 0.35),
      -2px 0 0 rgba(255, 122, 26, 0.4);
    animation: brand-flicker 7s infinite;
  }

  @keyframes brand-flicker {
    0%, 91%, 100% { opacity: 1; transform: none; }
    92% { opacity: 0.86; transform: translate(1px, -1px); }
    93% { opacity: 0.98; transform: translate(-1px, 1px); }
    94% { opacity: 0.9; transform: none; }
    96% { opacity: 1; }
  }

  .brand-typewrap {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    color: var(--white);
    letter-spacing: 0.08em;
    min-height: 1.9em;
    max-width: 64ch;
  }

  .brand-caret {
    color: var(--amber);
    animation: brand-caret-blink 1.1s steps(1) infinite;
    margin-left: 2px;
  }

  .brand-caret.done {
    animation: brand-caret-blink 1.6s ease-in-out infinite;
  }

  @keyframes brand-caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .brand-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }

  .brand-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .brand-radar {
    position: absolute;
    left: 3vw;
    bottom: 2.5rem;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    opacity: 0.55;
  }

  .brand-radar p {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    color: var(--cyan-dim);
    white-space: nowrap;
  }

  .id-card {
    max-width: 760px;
    margin-inline: auto;
  }

  .id-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .id-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cyan-dim);
  }

  .id-grid {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .id-photo {
    position: relative;
    margin: 0;
    border: 1px solid rgba(102, 204, 255, 0.45);
    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
    background: #0a0e14;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .id-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
  }

  .id-scanline {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 3px,
      rgba(102, 204, 255, 0.05) 3px 4px
    );
    mix-blend-mode: screen;
  }

  .id-photo figcaption {
    position: absolute;
    left: 8px;
    bottom: 8px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.26em;
    color: var(--amber);
    background: rgba(5, 8, 12, 0.72);
    padding: 2px 6px;
    border-left: 2px solid var(--amber);
  }

  .id-fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  .id-field {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: 1px dashed rgba(232, 237, 246, 0.12);
  }

  .id-field dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cyan-dim);
    padding-top: calc(var(--space-1) / 2);
  }

  .id-field dd {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--white);
  }

  .id-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan-dim);
  }

  @media (max-width: 640px) {
    .id-grid {
      grid-template-columns: 1fr;
    }

    .id-photo {
      max-width: 260px;
    }
  }

  .entries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-2);
  }

  .entries-empty {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  @media (min-width: 900px) {
    .brand-radar { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-title { animation: none; }
    .brand-caret { animation: none; }
  }
</style>