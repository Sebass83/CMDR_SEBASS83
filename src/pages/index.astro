---
/**
 * Landing — CMDR SEBASS83 commander log home.
 * Brand hero, "about the commander" placeholder block and latest blog entries.
 * The blog grid derives from the content collection: non-draft entries,
 * sorted by pubDate DESC.
 */
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/blog/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout>
  <section class="brand-hero">
    <div class="container brand-hero-inner">
      <p class="brand-kicker">BITÁCORA DE NAVEGACIÓN // SECTOR 001</p>

      <h1 class="brand-title">CMDR SEBASS83</h1>

      <p class="brand-typewrap">
        <span class="brand-type" id="typewriter-line" data-text="Bitácora de navegación: expediciones, señales e investigación independiente."></span><span class="brand-caret" id="typewriter-caret">▍</span>
      </p>

      <div class="brand-badges">
        <span class="badge badge-amber"><span class="dot"></span>Estado: EN CURSO</span>
        <span class="badge badge-cyan">Sector: POR ASIGNAR</span>
        <span class="badge badge-slate">Rango: PILOTO INDEPENDIENTE</span>
      </div>

      <div class="brand-cta">
        <a class="btn" href="#sobre">Sobre el commander</a>
        <a class="btn btn-cyan" href="#entradas">Últimas entradas</a>
      </div>
    </div>

    <!-- Decorative HUD sensor, echoing the RAXXLA hero -->
    <div class="brand-radar" aria-hidden="true">
      <div class="radar">
        <span class="blip" style="top: 30%; left: 62%"></span>
        <span class="blip" style="top: 64%; left: 30%; animation-delay: 0.8s"></span>
        <span class="blip" style="top: 48%; left: 48%; animation-delay: 1.6s"></span>
      </div>
      <p>SENSOR // SECTOR 001&nbsp;&nbsp;—&nbsp;&nbsp;SEÑAL ACTIVA</p>
    </div>
  </section>

  <section id="sobre">
    <div class="container">
      <header class="sec-head reveal">
        <span class="sec-code">SECCIÓN 00 // IDENTIDAD</span>
        <h2>Sobre el commander</h2>
        <p class="sec-sub">Identidad, trayectoria y motivación de navegación. Contenido pendiente de redactar.</p>
      </header>

      <div class="panel about-panel reveal">
        <span class="panel-tag">CONTENIDO PENDIENTE</span>
        <p>
          Este bloque es un marcador: se completará más adelante con la presentación de CMDR SEBASS83,
          su flota, sus expediciones destacadas y la motivación detrás de esta bitácora.
        </p>
      </div>
    </div>
  </section>

  <section id="entradas">
    <div class="container">
      <header class="sec-head reveal">
        <span class="sec-code">REGISTRO // ENTRADAS RECIENTES</span>
        <h2>Últimas entradas</h2>
        <p class="sec-sub">Puntos de la bitácora, de la más reciente a la más antigua.</p>
      </header>

      {
        posts.length > 0 ? (
          <div class="entries-grid">
            {posts.map((post, i) => <PostCard post={post} index={i + 1} />)}
          </div>
        ) : (
          <div class="panel entries-empty reveal">
            <span class="panel-tag">BITÁCORA VACÍA</span>
            <p>Sin entradas publicadas todavía. La primera entrada estará disponible pronto.</p>
          </div>
        )
      }
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .brand-hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-5);
    text-align: center;
    overflow: hidden;
  }

  .brand-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .brand-kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--cyan-dim);
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 11vw, 7rem);
    line-height: 0.98;
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    color: var(--amber-soft);
    text-shadow:
      0 0 40px rgba(255, 158, 0, 0.45),
      0 0 90px rgba(255, 158, 0, 0.2),
      2px 0 0 rgba(102, 204, 255, 0.35),
      -2px 0 0 rgba(255, 122, 26, 0.4);
    animation: brand-flicker 7s infinite;
  }

  @keyframes brand-flicker {
    0%, 91%, 100% { opacity: 1; transform: none; }
    92% { opacity: 0.86; transform: translate(1px, -1px); }
    93% { opacity: 0.98; transform: translate(-1px, 1px); }
    94% { opacity: 0.9; transform: none; }
    96% { opacity: 1; }
  }

  .brand-typewrap {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    color: var(--white);
    letter-spacing: 0.08em;
    min-height: 1.9em;
    max-width: 64ch;
  }

  .brand-caret {
    color: var(--amber);
    animation: brand-caret-blink 1.1s steps(1) infinite;
    margin-left: 2px;
  }

  .brand-caret.done {
    animation: brand-caret-blink 1.6s ease-in-out infinite;
  }

  @keyframes brand-caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .brand-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }

  .brand-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .brand-radar {
    position: absolute;
    left: 3vw;
    bottom: 2.5rem;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    opacity: 0.55;
  }

  .brand-radar p {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    color: var(--cyan-dim);
    white-space: nowrap;
  }

  .about-panel {
    max-width: 720px;
    margin-inline: auto;
  }

  .entries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-2);
  }

  .entries-empty {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  @media (min-width: 900px) {
    .brand-radar { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-title { animation: none; }
    .brand-caret { animation: none; }
  }
</style>