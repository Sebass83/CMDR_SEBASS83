---
/**
 * Timeline — official statements by Frontier developers, 2014-….
 * Source: investigacion.md section 3 (truth single source).
 */

const entries = [
  {
    when: '8 jul 2014',
    where: 'BAFTA',
    who: 'David Braben',
    text: '“Está ahí afuera y nosotros sabemos dónde está.”',
    note: 'Confirmado por Drew Wagar (detallado en 2021).',
  },
  {
    when: '2015',
    where: '—',
    who: 'Michael Brookes',
    text: '“No habrá pistas.”',
    note: 'Luego se contradijo: “tienes que hacer algo de esto un poquito obvio”.',
  },
  {
    when: '—',
    where: 'Entrevista con DJTruthsayer',
    who: 'Michael Brookes',
    text: '“Está en la Vía Láctea… un viaje que cada uno hace por sí mismo.”',
    note: '→ No se puede descartar ningún sistema por estar fuera de la galaxia.',
  },
  {
    when: '2017',
    where: 'Lavecon 2017 (Q&A), relatado por CMDR Ascorbius',
    who: 'Michael Brookes',
    text: '“El sistema donde está Raxxla ya fue visitado por un commander; saltaron y se fueron; o cargaron combustible y se fueron.”',
    note: 'Los permits de la 2.4 llegaron 2 meses después → los sistemas bloqueados NO están descartados.',
  },
  {
    when: '—',
    where: '—',
    who: 'Michael Brookes',
    text: 'No se necesita nave ni rango especial.',
    note: 'Elimina teorías de gating mecánico.',
  },
  {
    when: '—',
    where: '—',
    who: 'Ed Lewis (community manager)',
    text: 'Un cuaderno con la ubicación está bajo llave en la oficina de Braben.',
    note: '—',
  },
  {
    when: '—',
    where: 'Comunidad / ex-empleados',
    who: '—',
    text: 'Solo Braben y Brookes conocían la ubicación.',
    note: '—',
  },
  {
    when: '—',
    where: '—',
    who: 'Drew Wagar',
    text: '“Brookes fue responsable de cada sistema artesanal del juego.”',
    note: '→ Pudo colocar Raxxla como modificación del Stellar Forge (lead F).',
  },
  {
    when: '—',
    where: '—',
    who: 'Allen Stroud (co-guionista de lore)',
    text: '“Tenía más influencia de Lovecraft que de Holdstock.”',
    note: '→ Marco de interpretación: horror cósmico, no mito griego.',
  },
  {
    when: '—',
    where: '—',
    who: '—',
    text: 'Libro favorito de Brookes: Excession, de Iain M. Banks.',
    note: '→ El objeto “Excession” = cosa desconocida e incomprensible.',
  },
];
---

<section id="cronologia">
  <div class="container">
    <header class="sec-head reveal">
      <span class="sec-code">SECCIÓN 02 // REGISTRO OFICIAL</span>
      <h2>Declaraciones oficiales</h2>
      <p class="sec-sub">
        Línea de tiempo de lo que Frontier Developments y sus desarrolladores han dicho públicamente.
      </p>
    </header>

    <ol class="timeline">
      {
        entries.map((e, i) => (
          <li class="timeline-item reveal">
            <div class="timeline-marker" aria-hidden="true">
              <span></span>
            </div>
            <article class="timeline-card panel">
              <header class="timeline-head">
                <span class="timeline-when">{e.when}</span>
                <span class="timeline-idx">#{String(i + 1).padStart(2, '0')}</span>
              </header>
              <p class="timeline-who">{e.who}</p>
              <p class="timeline-text">{e.text}</p>
              <p class="timeline-note">{e.where && e.where !== '—' ? `Dónde: ${e.where} — ` : ''}{e.note}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 820px;
    margin-inline: auto;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 10px;
    width: 1px;
    background: linear-gradient(180deg, var(--amber), var(--cyan), transparent);
    opacity: 0.5;
  }

  .timeline-item {
    position: relative;
    padding-left: 2.7rem;
  }

  .timeline-marker {
    position: absolute;
    left: 3px;
    top: 1.2rem;
    width: 15px;
    height: 15px;
    display: grid;
    place-items: center;
  }

  .timeline-marker span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg-deep);
    border: 2px solid var(--amber);
    box-shadow: 0 0 10px rgba(255, 158, 0, 0.7);
  }

  .timeline-card { padding: var(--space-2) var(--space-3); }

  .timeline-card:hover {
    transform: none;
    border-color: rgba(102, 204, 255, 0.4);
    box-shadow: 0 4px 24px rgba(102, 204, 255, 0.1);
  }

  .timeline-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-1);
  }

  .timeline-when {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: var(--amber-soft);
  }

  .timeline-idx {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--slate-dim);
  }

  .timeline-who {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.25rem;
  }

  .timeline-text {
    color: var(--white);
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }

  .timeline-note {
    font-size: 0.88rem;
    color: var(--slate);
  }
</style>