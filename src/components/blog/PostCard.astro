---
/**
 * PostCard — blog entry card for the landing grid.
 * Links to the full entry; HUD panel styling consistent with the site.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  index: number;
}

const { post, index } = Astro.props;

const paddedIndex = String(index).padStart(3, '0');
const pubDate = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(post.data.pubDate);
---

<a class="post-card panel reveal" href={`${import.meta.env.BASE_URL}blog/${post.slug}/`}>
  <span class="post-card-kicker">ENTRADA // {paddedIndex}</span>
  <h3 class="post-card-title">{post.data.title}</h3>
  <time class="post-card-date" datetime={post.data.pubDate.toISOString()}>{pubDate}</time>
  <p class="post-card-desc">{post.data.description}</p>
  <ul class="post-card-tags">
    {
      post.data.tags.map((tag) => (
        <li><span class="badge badge-slate">{tag}</span></li>
      ))
    }
  </ul>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
  }

  .post-card-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cyan-dim);
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--amber-soft);
    margin-bottom: var(--space-1);
  }

  .post-card-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--slate);
  }

  .post-card-desc {
    flex-grow: 1;
    color: var(--slate);
    font-size: 0.98rem;
  }

  .post-card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-1);
  }
</style>