---
/**
 * BlogNav — navigation between blog entries.
 * Always shows a "back to the log" link; prev/next chips render only
 * when the corresponding entry exists (never an empty placeholder).
 */
interface PostRef {
  slug: string;
  title: string;
}

interface Props {
  prev?: PostRef;
  next?: PostRef;
}

const { prev, next } = Astro.props;
---

<nav class="blog-nav" aria-label="Navegación entre entradas de la bitácora">
  <a class="blog-nav-back" href={`${import.meta.env.BASE_URL}`}>← Volver a la bitácora</a>

  {(prev || next) && (
    <div class="blog-nav-chips">
      {
        prev && (
          <a class="blog-nav-chip" href={`${import.meta.env.BASE_URL}blog/${prev.slug}/`}>
            <span class="blog-nav-chip-label">ENTRADA ANTERIOR</span>
            <span class="blog-nav-chip-title">{prev.title}</span>
          </a>
        )
      }
      {
        next && (
          <a class="blog-nav-chip blog-nav-chip-next" href={`${import.meta.env.BASE_URL}blog/${next.slug}/`}>
            <span class="blog-nav-chip-label">ENTRADA SIGUIENTE</span>
            <span class="blog-nav-chip-title">{next.title}</span>
          </a>
        )
      }
    </div>
  )}
</nav>

<style>
  .blog-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .blog-nav-back {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cyan);
    align-self: flex-start;
  }

  .blog-nav-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .blog-nav-chip {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1 1 220px;
    max-width: 320px;
    border: 1px solid rgba(102, 204, 255, 0.22);
    background: linear-gradient(180deg, var(--bg-panel), var(--bg-panel-2));
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    transition: border-color var(--d-fast) ease, box-shadow var(--d-fast) ease;
  }

  .blog-nav-chip:hover {
    border-color: rgba(255, 158, 0, 0.5);
    box-shadow: 0 0 24px rgba(255, 158, 0, 0.1);
  }

  .blog-nav-chip-next {
    margin-left: auto;
  }

  .blog-nav-chip-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cyan-dim);
  }

  .blog-nav-chip-title {
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber-soft);
    line-height: 1.3;
  }
</style>