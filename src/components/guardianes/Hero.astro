---
/**
 * Hero — Guardianes masthead with typewriter line, Ram Tah toast and radar.
 * The kicker is a prop so the component can be reused; the default preserves
 * the original entry label.
 */

interface Props {
  kicker?: string;
}

const {
  kicker = 'COMANDER LOG // ENTRADA 002 — REFERENCIA NO OFICIAL',
} = Astro.props;

const toastText =
  '“¿Fueron destruidos? ¿O todavía existen, en algún lugar de la inmensidad del espacio?”';
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <p class="hero-kicker">{kicker}</p>

    <h1 class="hero-title">LOS GUARDIANES</h1>

    <p class="hero-typewrap">
      <span class="hero-type" id="typewriter-line" data-text="La civilización que ganó dos guerras."></span><span class="hero-caret" id="typewriter-caret">▍</span>
    </p>

    <blockquote class="hero-toast" id="hero-toast">
      <p>{toastText}</p>
      <footer>— RAM TAH // SOBRE LOS CONSTRUCTOS (LOG 27/28)</footer>
    </blockquote>

    <div class="hero-badge">
      <span class="badge badge-amber"><span class="dot"></span>Estatus: EXTINTA</span>
      <span class="badge badge-cyan">Tecnología: ACTIVA</span>
      <span class="badge badge-slate">Era: 1–2 M años</span>
    </div>

    <div class="hero-cta">
      <a class="btn" href="#hechos">Datos duros</a>
      <a class="btn btn-cyan" href="#misterios">Misterios abiertos</a>
    </div>
  </div>

  <!-- Decorative HUD sensor -->
  <div class="hero-radar" aria-hidden="true">
    <div class="radar">
      <span class="blip" style="top: 30%; left: 62%"></span>
      <span class="blip" style="top: 64%; left: 30%; animation-delay: 0.8s"></span>
      <span class="blip" style="top: 48%; left: 48%; animation-delay: 1.6s"></span>
    </div>
    <p>SENSOR // GUARDIANES&nbsp;&nbsp;—&nbsp;&nbsp;RUINAS ANTIGUAS</p>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-5);
    text-align: center;
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--cyan-dim);
  }

  /* The two-word title needs a smaller cap than the RAXXLA single word:
     same tokens, reduced clamp so "GUARDIANES" fits the container. */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 8vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    overflow-wrap: break-word;
    color: var(--amber-soft);
    text-shadow:
      0 0 40px rgba(255, 158, 0, 0.45),
      0 0 90px rgba(255, 158, 0, 0.2),
      2px 0 0 rgba(102, 204, 255, 0.35),
      -2px 0 0 rgba(255, 122, 26, 0.4);
    animation: hero-flicker 7s infinite;
  }

  @keyframes hero-flicker {
    0%, 91%, 100% { opacity: 1; transform: none; }
    92% { opacity: 0.86; transform: translate(1px, -1px); }
    93% { opacity: 0.98; transform: translate(-1px, 1px); }
    94% { opacity: 0.9; transform: none; }
    96% { opacity: 1; }
  }

  .hero-typewrap {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.6vw, 1.35rem);
    color: var(--white);
    letter-spacing: 0.08em;
    min-height: 1.9em;
  }

  .hero-caret {
    color: var(--amber);
    animation: caret-blink 1.1s steps(1) infinite;
    margin-left: 2px;
  }

  .hero-caret.done {
    animation: caret-blink 1.6s ease-in-out infinite;
  }

  @keyframes caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-toast {
    max-width: 62ch;
    font-style: italic;
    color: var(--slate);
    border-left: 2px solid var(--amber);
    padding-left: var(--space-3);
    text-align: left;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
  }

  .hero-toast.visible {
    opacity: 1;
    transform: none;
  }

  .hero-toast footer {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--cyan-dim);
    margin-top: var(--space-1);
  }

  .hero-badge {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .hero-radar {
    position: absolute;
    left: 3vw;
    bottom: 2.5rem;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    opacity: 0.55;
  }

  .hero-radar p {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    color: var(--cyan-dim);
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .hero-radar { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title { animation: none; }
    .hero-toast { opacity: 1; transform: none; }
    .hero-caret { animation: none; }
  }
</style>