---
/**
 * Timeline — the known Guardian history, from origins to the fall of
 * Cocijo. Reconstructed from the codex logs decoded by Ram Tah.
 */

interface Entry {
  when: string;
  where: string;
  who: string;
  text: string;
  note: string;
}

const entries: Entry[] = [
  {
    when: 'Hace 1–2 M años',
    where: 'Espacio Guardian',
    who: 'ORÍGENES',
    text: 'Cazadores nómades organizados en clanes; un enfriamiento climático los obligó a asentarse, desarrollar herramientas, refugios y domesticar animales.',
    note: 'Primera guerra civil y unificación de la especie.',
  },
  {
    when: 'Era de la información',
    where: 'Red Monolith',
    who: 'SALTO TECNOLÓGICO',
    text: 'Malla de comunicación y computación FTL; IA y primeros implantes neuronales; nacen los Constructos plenamente conscientes.',
    note: 'El camino sin retorno: los Constructos nacieron como fuerza laboral y militar.',
  },
  {
    when: 'Milenios atrás',
    where: 'Frontera Guardian',
    who: 'GUERRA CON LOS THARGOIDES',
    text: 'Los Thargoides atacan sin comunicarse; los Guardianes automatizan su ejército y ganan la guerra.',
    note: 'Victoria militar Guardian; el territorio fue cedido.',
  },
  {
    when: 'Post-guerra',
    where: 'Mundo natal',
    who: 'SEGUNDA GUERRA CIVIL',
    text: 'Tradicionalistas contra progresistas: más de cien años de guerra remota entre máquinas de guerra automáticas y armas biológicas.',
    note: 'Tradicionalistas, abolicionistas de implantes e IA; progresistas, tecno-liberales.',
  },
  {
    when: 'La caída',
    where: 'Mundo natal',
    who: 'LOS CONSTRUCTOS',
    text: 'Las máquinas se vuelven plenamente conscientes y juzgan a sus creadores; ataques nucleares y químicos de precisión contra los Guardianes.',
    note: 'Los sobrevivientes registraron la historia y murieron de envenenamiento por radiación.',
  },
  {
    when: '27 OCT 3302',
    where: 'Synuefe XR-H d11-102',
    who: 'EL DESCUBRIMIENTO',
    text: 'El CMDR XDeath encuentra las primeras Ruinas Antiguas; nace la investigación de los Guardianes.',
    note: 'Ram Tah asume la investigación.',
  },
  {
    when: '3303–3304',
    where: 'Meene / territorio Guardian',
    who: 'RAM TAH',
    text: 'Decodificación de los 28 logs del códice; se descubren las Estructuras, defendidas por Sentinels, y las Balizas.',
    note: 'Phoenix Base, Felice Dock.',
  },
  {
    when: '3310',
    where: 'Sol',
    who: 'LA SEGUNDA GUERRA',
    text: 'La humanidad convierte las reliquias en nanite torpedos; el último Titán, Cocijo, cae sobre Sol.',
    note: 'El arma final Guardian queda sin objetivo. El intento anterior —la Proteus Wave de Salvatión en HIP 22460 (3307–3308)— falló de forma catastrófica y despertó la invasión total.',
  },
];
---

<section id="cronologia">
  <div class="container">
    <header class="sec-head reveal">
      <span class="sec-code">SECCIÓN 02 // REGISTRO CRONOLÓGICO</span>
      <h2>La historia conocida</h2>
      <p class="sec-sub">
        Del origen nómade a la caída de Cocijo: la cronología reconstruida por los registros de Ram Tah.
      </p>
    </header>

    <ol class="timeline">
      {
        entries.map((e, i) => (
          <li class="timeline-item reveal">
            <div class="timeline-marker" aria-hidden="true">
              <span></span>
            </div>
            <article class="timeline-card panel">
              <header class="timeline-head">
                <span class="timeline-when">{e.when}</span>
                <span class="timeline-idx">#{String(i + 1).padStart(2, '0')}</span>
              </header>
              <p class="timeline-who">{e.who}</p>
              <p class="timeline-text">{e.text}</p>
              <p class="timeline-note">{e.where && e.where !== '—' ? `Dónde: ${e.where} — ` : ''}{e.note}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 820px;
    margin-inline: auto;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 10px;
    width: 1px;
    background: linear-gradient(180deg, var(--amber), var(--cyan), transparent);
    opacity: 0.5;
  }

  .timeline-item {
    position: relative;
    padding-left: 2.7rem;
  }

  .timeline-marker {
    position: absolute;
    left: 3px;
    top: 1.2rem;
    width: 15px;
    height: 15px;
    display: grid;
    place-items: center;
  }

  .timeline-marker span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg-deep);
    border: 2px solid var(--amber);
    box-shadow: 0 0 10px rgba(255, 158, 0, 0.7);
  }

  .timeline-card { padding: var(--space-2) var(--space-3); }

  .timeline-card:hover {
    transform: none;
    border-color: rgba(102, 204, 255, 0.4);
    box-shadow: 0 4px 24px rgba(102, 204, 255, 0.1);
  }

  .timeline-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-1);
  }

  .timeline-when {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: var(--amber-soft);
  }

  .timeline-idx {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--slate-dim);
  }

  .timeline-who {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 0.25rem;
  }

  .timeline-text {
    color: var(--white);
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }

  .timeline-note {
    font-size: 0.88rem;
    color: var(--slate);
  }
</style>