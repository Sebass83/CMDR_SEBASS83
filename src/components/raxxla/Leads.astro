---

<section id="leads">
  <div class="container">
    <header class="sec-head reveal">
      <span class="sec-code">SECCIÓN 03 // TEORÍAS ACTIVAS</span>
      <h2>Los leads</h2>
      <p class="sec-sub">
        Nueve líneas de investigación documentadas (A-I), con coordenadas cuando existen y prioridad según la matriz de decisión.
      </p>
    </header>

    <div class="leads-grid">
      {
        leads.map((l) => (
          <article class="panel lead-card reveal">
            <header class="lead-head">
              <span class="lead-letter">LEAD {l.letter}</span>
              <div class="lead-badges">
                <span class={'badge ' + l.badge}>{l.priority}</span>
                <span class="badge badge-slate">{l.access}</span>
              </div>
            </header>

            <h3>{l.name}</h3>
            <p class="lead-sub">{l.subtitle}</p>

            <p class="lead-coords">{l.coords}</p>

            <p class="lead-body">{l.body}</p>

            <footer class="lead-meta">
              <span>Sesiones: <strong>{l.sessions}</strong></span>
              <span>Riesgo: <strong>{l.risk}</strong></span>
            </footer>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .leads-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space-2);
  }

  .lead-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .lead-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-1);
  }

  .lead-letter {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    color: var(--cyan-dim);
  }

  .lead-badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .lead-sub {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--slate);
    margin-bottom: var(--space-1);
  }

  .lead-coords {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--amber-soft);
    background: rgba(255, 158, 0, 0.06);
    border: 1px dashed rgba(255, 158, 0, 0.35);
    padding: 0.5em 0.8em;
    margin-bottom: var(--space-1);
  }

  .lead-body {
    flex-grow: 1;
    font-size: 0.94rem;
  }

  .lead-meta {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: var(--slate);
    border-top: 1px solid rgba(102, 204, 255, 0.15);
    padding-top: var(--space-1);
  }

  .lead-meta strong {
    color: var(--cyan);
  }
</style>