  { name: 'Fandom — Raxxla (codex + declaraciones)', url: 'https://elite-dangerous.fandom.com/wiki/Raxxla' },
  { name: 'Canonn Research — Drew Wagar Lore: Raxxla', url: 'https://canonn.science/lore/drewwagar-raxxla/' },
  { name: 'Canonn Research — The Dark Wheel', url: 'https://canonn.science/lore/drewwagar-the-dark-wheel/' },
  { name: 'Inara — The Quest for Raxxla (serie, Zer0Cool0, may 2026)', url: 'https://inara.cz/elite/logbook/95366' },
  { name: 'Inara — “And This Is How You Find Raxxla” (K Dutch, jul 2026)', url: 'https://inara.cz/elite/logbook/96864' },
  { name: 'Inara — “A new hunt for Raxxla” ANHR (CamaVixen, sep 2025)', url: 'https://inara.cz/elite/logbook/89379' },
  { name: 'Inara — “The R-Word” (Rawnu, feb 2025)', url: 'https://inara.cz/elite/logbook/85272' },
  { name: 'Inara — Jester Journalism: Mystery of the Dark Wheel', url: 'https://inara.cz/elite/logbook/88300' },
  { name: 'Foros Frontier — The Quest To Find Raxxla (hilo oficial 2015+)', url: 'https://forums.frontier.co.uk/threads/the-quest-to-find-raxxla.168253/' },
  { name: 'EDSM — PMD2009 48 (Orion Nebula Tourist Centre)', url: 'https://www.edsm.net/en/system/id/347921/name/PMD2009%2048' },
  { name: 'Inara — LFT 926', url: 'https://inara.cz/elite/starsystem/686' },
  { name: 'Inara — The Dark Wheel (facción)', url: 'https://inara.cz/elite/minorfaction/28704' },
  { name: 'Steam — RAXXLA Locations (teoría Cassiopeia)', url: 'https://steamcommunity.com/app/359320/discussions/0/1849197902664192462' },
  { name: 'Reddit — “Raxxla is 100% somewhere in the Bubble”', url: 'https://www.reddit.com/r/EliteDangerous/comments/9y2m7h/' },
