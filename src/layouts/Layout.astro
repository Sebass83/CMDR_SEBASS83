---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CMDR SEBASS83 — Bitácora de navegación',
  description = 'Bitácora de navegación e investigación independiente de CMDR SEBASS83: expediciones, señales anómalas y la búsqueda documentada de RAXXLA en Elite Dangerous.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Ambient space background layers -->
    <div class="nebula" aria-hidden="true"></div>
    <canvas id="starfield" aria-hidden="true"></canvas>
    <div class="scanlines" aria-hidden="true"></div>

    <nav class="topnav" aria-label="Principal">
      <div class="container topnav-inner">
        <a class="topnav-brand" href={`${import.meta.env.BASE_URL}`}>CMDR SEBASS83</a>
        <a class="topnav-link" href={`${import.meta.env.BASE_URL}`}>Bitácora</a>
      </div>
    </nav>

    <main id="top">
      <slot />
    </main>

    <script src="../scripts/starfield.js"></script>
    <script src="../scripts/reveal.js"></script>
    <script src="../scripts/typewriter.js"></script>
  </body>
</html>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(5, 7, 13, 0.82);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(102, 204, 255, 0.25);
  }

  .topnav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.7rem;
  }

  .topnav-brand {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--amber-soft);
    text-decoration: none;
    border-bottom: none;
  }

  .topnav-brand:hover {
    color: var(--amber);
    border-bottom: none;
  }

  .topnav-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cyan);
    text-decoration: none;
    border-bottom: 1px solid rgba(102, 204, 255, 0.4);
    padding-bottom: 0.15em;
  }

  .topnav-link:hover {
    color: var(--cyan);
    border-bottom-color: var(--amber);
  }

  main {
    position: relative;
    z-index: 1;
  }
</style>